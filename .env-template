# Copy this file to .env and fill in ONE provider's key.
# MODEL_PROVIDER selects which of the three call_llm() branches in llm.py runs.
# MODEL_NAME is optional -- each provider has a sensible default in llm.py if you leave it blank.

MODEL_PROVIDER=openai
# openai | anthropic | groq

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# MODEL_NAME=gpt-4o-mini
# MODEL_NAME=claude-haiku-4-5-20251001
# MODEL_NAME=openai/gpt-oss-120b
